#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @TKA_VERSION_MAJOR@,@TKA_VERSION_MINOR@,@TKA_VERSION_PATCH@,0
 PRODUCTVERSION @TKA_VERSION_MAJOR@,@TKA_VERSION_MINOR@,@TKA_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Techno Kitten Adventure Setup\0"
      VALUE "FileVersion", "@TKA_VERSION@.0\0"
      VALUE "OriginalFilename", "Setup Techno Kitten Adventure.exe\0"
      VALUE "ProductName", "Techno Kitten Adventure PC Port\0"
      VALUE "ProductVersion", "@TKA_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
